// LALRPOP grammar for pgbench expressions
// This is a proof-of-concept implementation porting from original-source/exprparse.y
//
// Reference: original-source/exprparse.y (Bison grammar)
//           original-source/exprscan.l (Flex lexer)

use crate::types::{PgBenchExpr, PgBenchValue, PgBenchFunction};
use crate::error::{PgBenchError, PgBenchResult};
use std::str::FromStr;

grammar;

// Match the precedence from exprparse.y lines 69-78
// Precedence: lowest to highest (matching PostgreSQL SQL parser)

// Entry point - returns a PgBenchExpr AST
pub Expr: Box<PgBenchExpr> = {
    // Tier 6: Logical OR (lowest precedence)
    <l:Expr> "OR" <r:AndExpr> => {
        Box::new(PgBenchExpr::Function {
            function: PgBenchFunction::Or,
            args: vec![*l, *r],
        })
    },
    AndExpr,
};

AndExpr: Box<PgBenchExpr> = {
    // Tier 5: Logical AND
    <l:AndExpr> "AND" <r:NotExpr> => {
        Box::new(PgBenchExpr::Function {
            function: PgBenchFunction::And,
            args: vec![*l, *r],
        })
    },
    NotExpr,
};

NotExpr: Box<PgBenchExpr> = {
    // Tier 4: Logical NOT
    "NOT" <e:CompExpr> => {
        Box::new(PgBenchExpr::Function {
            function: PgBenchFunction::Not,
            args: vec![*e],
        })
    },
    CompExpr,
};

CompExpr: Box<PgBenchExpr> = {
    // Tier 3: Comparison operators
    <l:AddExpr> "=" <r:AddExpr> => {
        Box::new(PgBenchExpr::Function {
            function: PgBenchFunction::Eq,
            args: vec![*l, *r],
        })
    },
    <l:AddExpr> "<>" <r:AddExpr> => {
        Box::new(PgBenchExpr::Function {
            function: PgBenchFunction::Ne,
            args: vec![*l, *r],
        })
    },
    <l:AddExpr> "<" <r:AddExpr> => {
        Box::new(PgBenchExpr::Function {
            function: PgBenchFunction::Lt,
            args: vec![*l, *r],
        })
    },
    <l:AddExpr> "<=" <r:AddExpr> => {
        Box::new(PgBenchExpr::Function {
            function: PgBenchFunction::Le,
            args: vec![*l, *r],
        })
    },
    <l:AddExpr> ">" <r:AddExpr> => {
        Box::new(PgBenchExpr::Function {
            function: PgBenchFunction::Lt,
            args: vec![*r, *l],  // Swap: a > b becomes b < a
        })
    },
    <l:AddExpr> ">=" <r:AddExpr> => {
        Box::new(PgBenchExpr::Function {
            function: PgBenchFunction::Le,
            args: vec![*r, *l],  // Swap: a >= b becomes b <= a
        })
    },
    AddExpr,
};

AddExpr: Box<PgBenchExpr> = {
    // Tier 2: Addition and subtraction
    <l:AddExpr> "+" <r:MulExpr> => {
        Box::new(PgBenchExpr::Function {
            function: PgBenchFunction::Add,
            args: vec![*l, *r],
        })
    },
    <l:AddExpr> "-" <r:MulExpr> => {
        Box::new(PgBenchExpr::Function {
            function: PgBenchFunction::Sub,
            args: vec![*l, *r],
        })
    },
    MulExpr,
};

MulExpr: Box<PgBenchExpr> = {
    // Tier 1: Multiplication, division, modulo (highest precedence for binary ops)
    <l:MulExpr> "*" <r:UnaryExpr> => {
        Box::new(PgBenchExpr::Function {
            function: PgBenchFunction::Mul,
            args: vec![*l, *r],
        })
    },
    <l:MulExpr> "/" <r:UnaryExpr> => {
        Box::new(PgBenchExpr::Function {
            function: PgBenchFunction::Div,
            args: vec![*l, *r],
        })
    },
    <l:MulExpr> "%" <r:UnaryExpr> => {
        Box::new(PgBenchExpr::Function {
            function: PgBenchFunction::Mod,
            args: vec![*l, *r],
        })
    },
    UnaryExpr,
};

UnaryExpr: Box<PgBenchExpr> = {
    // Unary operators
    "+" <e:UnaryExpr> => e,  // Unary plus is identity
    "-" <e:UnaryExpr> => {
        // Unary minus implemented as "0 - x" (matching exprparse.y line 95)
        Box::new(PgBenchExpr::Function {
            function: PgBenchFunction::Sub,
            args: vec![
                PgBenchExpr::Constant(PgBenchValue::int(0)),
                *e,
            ],
        })
    },
    AtomExpr,
};

AtomExpr: Box<PgBenchExpr> = {
    // Parentheses
    "(" <Expr> ")",

    // Constants
    <n:Integer> => Box::new(PgBenchExpr::Constant(PgBenchValue::int(n))),
    <d:Double> => Box::new(PgBenchExpr::Constant(PgBenchValue::double(d))),
    <b:Boolean> => Box::new(PgBenchExpr::Constant(PgBenchValue::boolean(b))),
    "NULL" => Box::new(PgBenchExpr::Constant(PgBenchValue::null())),

    // Variables
    <v:Variable> => Box::new(PgBenchExpr::Variable { name: v }),

    // Function calls (simplified for POC - will expand later)
    <f:FunctionName> "(" <args:CommaList<Expr>> ")" => {
        Box::new(PgBenchExpr::Function {
            function: f,
            args: args.into_iter().map(|b| *b).collect(),
        })
    },
};

// Comma-separated list of expressions
CommaList<T>: Vec<T> = {
    <mut v:(<T> ",")*> <e:T?> => match e {
        None => v,
        Some(e) => {
            v.push(e);
            v
        }
    }
};

// Terminals (tokens)

Integer: i64 = {
    r"[0-9]+" => i64::from_str(<>).unwrap(),
};

Double: f64 = {
    // Match integers with decimal point or scientific notation
    r"[0-9]+\.[0-9]*([eE][+-]?[0-9]+)?" => f64::from_str(<>).unwrap(),
    r"\.[0-9]+([eE][+-]?[0-9]+)?" => f64::from_str(<>).unwrap(),
    r"[0-9]+[eE][+-]?[0-9]+" => f64::from_str(<>).unwrap(),
};

Boolean: bool = {
    "TRUE" => true,
    "FALSE" => false,
};

Variable: String = {
    r":[a-zA-Z_][a-zA-Z0-9_]*" => {
        // Strip the leading ':' from variable name
        <>[1..].to_string()
    },
};

FunctionName: PgBenchFunction = {
    "abs" => PgBenchFunction::Abs,
    "sqrt" => PgBenchFunction::Sqrt,
    "pi" => PgBenchFunction::Pi,
    "debug" => PgBenchFunction::Debug,
    // More functions will be added in full implementation
};

// Skip whitespace
match {
    r"\s*" => { },  // Skip whitespace
    _
}
